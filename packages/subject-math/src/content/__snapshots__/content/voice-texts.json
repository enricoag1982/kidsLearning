 },
 {
  "key": "26d022e16da63ffb",
  "text": "Elephant has 93 peanuts. Penguin has 31 peanuts. How many more peanuts does Elephant have than Penguin?",
  "source": "minigame-round"
 },
 {
  "key": "27926fb89f8ed575",
  "text": "The tens make 90, then the ones make 10 more. This one is tricky. Want an easier one?",
  "source": "exercise-note-easier-offer"
 },
