  "key": "32813fb993cc7953",
  "text": "You add 3. Now it's 12.",
  "source": "race-you-add"
 },
 {
  "key": "33c7bae80c76f22c",
  "text": "Want to show me you already know World 2 · Mental Math Mountain?",
  "source": "journey"
 },
 {
  "key": "33cacbfd0bfeadc3",
  "text": "A grown-up helps set things up first.",
  "source": "owl-line"
 },
 {
  "key": "342f4548d30b58b4",
  "text": "Find the middle: 500.",
  "source": "exercise-note"
 },
 {
  "key": "34ca72ef1afcb95b",
  "text": "Hedgie adds 2. Now it's 5.",
