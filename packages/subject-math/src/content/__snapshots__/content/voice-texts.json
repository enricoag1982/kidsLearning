 },
 {
  "key": "3881d42a930c6875",
  "text": "What is 6 times 5?",
  "source": "lesson-exercise"
 },
 {
  "key": "3960df81cc3e637f",
  "text": "What is 10 times 7?",
  "source": "lesson-guided"
 },
 {
  "key": "396adb0d3249bc26",
  "text": "Owl says: adding 10 changes only the tens digit, and adding 100 only the hundreds digit. Hedgie uses round numbers for the nearly ones, because 99 is 100 less 1. Add the round number, then fix the 1!",
  "source": "lesson-story"
 },
 {
  "key": "39845df5f7eacbe1",
  "text": "Number Builder",
  "source": "badge-earned"
 },
 {
  "key": "3987935cbc0d1250",
  "text": "Owl says: every digit has a place. Hedgie counts the hundreds, then the tens, then the ones. An empty place still needs a zero!",
  "source": "lesson-story"
 },
 {
  "key": "3a0d9cd3776374e4",
  "text": "Build 1357 with blocks.",
  "source": "lesson-variant"
 },
 {
  "key": "3acb2424f8ae131f",
  "text": "Look: 46 plus 99. Add 100 to get 146. But 99 is 1 less than 100, so take 1 away: 145!",
  "source": "lesson-demo"
 },
 {
  "key": "3b199d66b044403d",
  "text": "You add 3. Now it's 4.",
  "source": "race-you-add"
 },
 {
  "key": "3c2f8a1874702ecd",
  "text": "Which two numbers make 100?",
  "source": "lesson-exercise"
 },
 {
  "key": "3d5f11edd51339bf",
  "text": "Build 507 with blocks.",
  "source": "lesson-exercise"
 },
 {
  "key": "3d757d2a6345d283",
  "text": "Fox has 68 red berries and 25 blue berries. How many berries in all?",
  "source": "lesson-exercise"
 },
 {
  "key": "3d9037e393bce080",
  "text": "Times means groups: 3 groups of 4. This one is tricky. Want an easier one?",
