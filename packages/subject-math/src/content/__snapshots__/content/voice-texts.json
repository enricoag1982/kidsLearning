[
 {
  "key": "0040f50b3371db58",
  "text": "Owl says: rounding finds the nearest ten or hundred. Hedgie checks the next digit: 5 or more goes up, less than 5 stays down.",
  "source": "lesson-story"
 },
 {
  "key": "00566cd46adcb795",
  "text": "Hundreds, tens and ones: count each column.",
  "source": "exercise-note"
 },
 {
  "key": "0063e6084b5401f5",
  "text": "Mountain Climber. Master Mental Math Mountain and beat Market Orders",
  "source": "badge-locked"
 },
 {
  "key": "020b263dfbd1a798",
  "text": "Count up from the smaller number. How many?",
  "source": "lesson-exercise"
 },
 {
  "key": "02ad3a8c4f9ee3bf",
  "text": "Cat has 11 stickers. Bear has 27 stickers. How many more stickers does Bear have than Cat?",
  "source": "lesson-exercise"
 },
 {
  "key": "030380e85348e652",
  "text": "Look: 64 plus what makes 100? The tens: 6 and 3 make 90. The ones: 4 and 6 make 10. So 36 goes in the gap!",
  "source": "lesson-demo"
 },
 {
  "key": "035fab1c1f095fe6",
  "text": "You add 2. Now it's 6.",
  "source": "race-you-add"
 },
 {
  "key": "043090b61e127a8d",
  "text": "Count the jumps between the marks, not the marks.",
  "source": "exercise-note"
 },
 {
  "key": "04a83fcf89fa37d0",
  "text": "See you tomorrow!",
  "source": "owl-line"
 },
 {
  "key": "0765d217efd1be88",
  "text": "What is 4 times 4?",
  "source": "lesson-variant"
 },
 {
  "key": "082c1205ad7d720d",
  "text": "Bear sold 17 loaves in the morning and 53 in the afternoon. How many loaves did Bear sell?",
  "source": "lesson-guided"
 },
 {
  "key": "09d0d86ca82c29e8",
  "text": "It starts with 7.",
  "source": "exercise-note"
 },
 {
  "key": "0a2ba2d1bd8cb77c",
  "text": "Not that one. Try another! This one is tricky. Want an easier one?",
  "source": "exercise-note-easier-offer"
 },
 {
  "key": "0adad9392203eca4",
  "text": "Look: Fox has 12 berries and finds 5 more. The berries come together, so add. 12 plus 5 makes 17!",
  "source": "lesson-demo"
 },
 {
  "key": "0adfa5ef877f3ded",
  "text": "You add 3. Now it's 6.",
  "source": "race-you-add"
 },
 {
  "key": "0b7223b2cfbf1508",
  "text": "You add 1. Now it's 3.",
  "source": "race-you-add"
 },
 {
  "key": "0bb4063e44507b4d",
  "text": "What is 4 times 5?",
  "source": "lesson-guided"
 },
