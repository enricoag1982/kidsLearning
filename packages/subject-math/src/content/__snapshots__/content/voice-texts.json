  "key": "27dfb80057b25845",
  "text": "Here is the answer.",
  "source": "exercise-note"
 },
 {
  "key": "284a0a38e213836f",
  "text": "Double the tens and the ones. This one is tricky. Want an easier one?",
  "source": "exercise-note-easier-offer"
 },
 {
  "key": "289dc8b48e417118",
  "text": "Hedgie adds 1. Now it's 8.",
  "source": "race-bot-adds"
 },
 {
  "key": "289ddbf20c286ee4",
  "text": "Mountain Climber",
  "source": "badge-earned"
 },
 {
  "key": "295d1293c6cb3154",
  "text": "You add 3. Now it's 8.",
  "source": "race-you-add"
 },
 {
  "key": "2a3e32b0ee2e7038",
  "text": "Hedgie adds 3. Now it's 17.",
  "source": "race-bot-adds"
 },
 {
  "key": "2a4006274f5195ba",
  "text": "Here are the hundreds. Now finish!",
