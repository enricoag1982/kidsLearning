  "source": "assessment"
 },
 {
  "key": "4b689e8883d9f9d1",
  "text": "Look: 38 plus 7. Make a ten first: 2 more makes 40. Then 5 are left, so 40 plus 5 is 45!",
  "source": "lesson-demo"
 },
 {
  "key": "4b8f57473d4f9733",
  "text": "Build 243 with blocks.",
  "source": "lesson-guided"
 },
 {
  "key": "4c36363e633953a6",
  "text": "World boss time: Race to 20!",
  "source": "home"
 },
 {
