  "key": "159b3dec13ee4d7b",
  "text": "You add 1. Now it's 18.",
  "source": "race-you-add"
 },
 {
  "key": "15cb245201fdca70",
  "text": "You already know 1 world! Off you go!",
  "source": "placement"
 },
 {
  "key": "161fdcce3e2e7cdb",
  "text": "Amazing!",
  "source": "exercise-note"
 },
 {
  "key": "165e28ae2db18a84",
  "text": "Round 47 to the nearest ten. The ones digit is 7, so go up. 47 is closer to 50 than to 40!",
  "source": "lesson-demo"
 },
 {
  "key": "18c7037d4c916de9",
  "text": "What is 5 times 6? Count by 5, six times: 5, 10, 15, 20, 25, 30. So 5 times 6 is 30!",
  "source": "lesson-demo"
 },
 {
  "key": "191367b6765e1f13",
  "text": "What is 4 times 3? Double 3 makes 6, and double 6 makes 12. So 4 times 3 is 12!",
  "source": "lesson-demo"
 },
 {
  "key": "198d22a4fd3d9094",
  "text": "You add 3. Now it's 13.",
  "source": "race-you-add"
 },
 {
  "key": "1999ccd69364e1f5",
  "text": "An empty place still needs a zero to hold its spot.",
  "source": "exercise-note"
 },
 {
  "key": "19ec971cf6b3801f",
  "text": "What number makes 100?",
  "source": "lesson-variant"
 },
 {
  "key": "1a3815a5556c46cd",
  "text": "Hedgie adds 2. Now it's 3.",
  "source": "race-bot-adds"
 },
 {
  "key": "1a67179222a1edd0",
  "text": "So close, just one off! Count again.",
  "source": "exercise-note"
 },
 {
  "key": "1bbe1997a90792f7",
  "text": "So close! Count the last jump again.",
  "source": "exercise-note"
 },
 {
  "key": "1c34d091721707b7",
  "text": "Hedgie adds 2. Now it's 6.",
  "source": "race-bot-adds"
 },
 {
  "key": "1dd0842b73d9826e",
  "text": "Round 354 to the nearest hundred.",
  "source": "lesson-exercise"
 },
 {
  "key": "1e5957546ab31adf",
  "text": "Double 13.",
  "source": "lesson-guided"
 },
 {
  "key": "1ecd5512c0d691cb",
  "text": "Not there yet. Look at the numbers on the line.",
  "source": "exercise-note"
 },
 {
  "key": "1f326b672a783891",
  "text": "Put every carriage number where it belongs on the line!",
