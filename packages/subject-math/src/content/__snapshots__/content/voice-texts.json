 },
 {
  "key": "42f092e3666a484a",
  "text": "You add 2. Now it's 15.",
  "source": "race-you-add"
 },
 {
  "key": "43ea50bd5c3f3cd9",
  "text": "Owl says: ten hundreds make one thousand. The thousands get a place on the left. Hedgie reads thousands, hundreds, tens, then ones!",
  "source": "lesson-story"
 },
